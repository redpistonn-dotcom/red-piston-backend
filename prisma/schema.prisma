generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AUTH & IDENTITY
// ═══════════════════════════════════════════════════════════════════════════════

// Lookup table for user roles — single source of truth for role definitions.
// slug maps 1:1 with the role string on User.
// id is a plain auto-increment integer (1=Customer, 2=Staff, 3=Owner, 4=Admin).
model UserType {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("user_types")
}

// Single identity record for every person in the system.
// Role controls which app surface they access (ERP vs Marketplace vs Admin).
model User {
  userId             Int       @id @default(autoincrement()) @map("user_id")
  name               String?
  email              String?   @unique
  phone              String?   @unique
  avatarUrl          String?   @map("avatar_url")
  passwordHash       String?   @map("password_hash")
  // CUSTOMER | SHOP_STAFF | SHOP_OWNER | PLATFORM_ADMIN
  role               String    @default("CUSTOMER")
  userTypeId         Int?      @map("user_type_id")
  userType           UserType? @relation(fields: [userTypeId], references: [id])
  emailVerified      Boolean   @default(false) @map("email_verified")
  phoneVerified      Boolean   @default(false) @map("phone_verified")
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until")
  loginCount         Int       @default(0) @map("login_count")
  lastLoginAt        DateTime? @map("last_login_at")
  isActive           Boolean   @default(true) @map("is_active")
  // Computed convenience: true once any auth method is verified
  isVerified         Boolean   @default(false) @map("is_verified")
  // Primary shop association for SHOP_OWNER / SHOP_STAFF
  shopId             Int?      @map("shop_id")
  shop               Shop?     @relation(fields: [shopId], references: [shopId])
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  // Shop owner verification
  // NOT_REQUIRED | PENDING | APPROVED | REJECTED
  verificationStatus String    @default("NOT_REQUIRED") @map("verification_status")
  verificationNote   String?   @map("verification_note")
  verifiedAt         DateTime? @map("verified_at")
  verifiedBy         String?   @map("verified_by")

  authProviders         AuthProvider[]
  refreshTokens         RefreshToken[]
  passwordResets        PasswordResetToken[]
  profile               UserProfile?
  settings              UserSettings?
  customerProfile       CustomerProfile?
  addresses             CustomerAddress[]
  garage                CustomerVehicle[]
  shopUsers             ShopUser[]
  adminProfile          AdminProfile?
  createdInvoices       Invoice[]            @relation("InvoiceCreatedBy")
  createdMovements      Movement[]           @relation("MovementCreatedBy")
  createdJobCards       JobCard[]            @relation("JobCardCreatedBy")
  createdPurchaseOrders PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  createdSalesReturns   SalesReturn[]        @relation("SalesReturnCreatedBy")
  marketplaceOrders     MarketplaceOrder[]   @relation("OrderCustomer")
  reviews               MarketplaceReview[]
  confirmFitRequests    ConfirmFitRequest[]

  @@index([shopId]) // list all users belonging to a shop
  @@index([role]) // admin role-based queries
  @@map("users")
}

// One row per login method per user (Google sub, Firebase UID, phone, email).
model AuthProvider {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  // EMAIL | PHONE | GOOGLE | FIREBASE
  provider   String
  providerId String   @map("provider_id")
  linkedAt   DateTime @default(now()) @map("linked_at")
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_providers")
}

// Hashed OTPs for phone login and email verification.
model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String?
  email      String?
  code       String
  // PHONE_OTP | EMAIL_VERIFY | EMAIL_LOGIN
  type       String    @default("PHONE_OTP")
  attempts   Int       @default(0)
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  used       Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, expiresAt(sort: Desc)])
  @@index([email, expiresAt(sort: Desc)])
  @@index([expiresAt])
  @@map("otp_codes")
}

// Active sessions — one row per device per user.
model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  shopId     Int?      @map("shop_id")
  tokenHash  String    @unique @map("token_hash")
  deviceInfo Json      @default("{}") @map("device_info")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Short-lived email password reset tokens — stored as SHA-256 hash.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════════
// USER PROFILES & SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

model UserProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  gender      String?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSettings {
  id                   Int     @id @default(autoincrement())
  userId               Int     @unique @map("user_id")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  emailNotifications   Boolean @default(true) @map("email_notifications")
  smsNotifications     Boolean @default(true) @map("sms_notifications")
  darkMode             Boolean @default(true) @map("dark_mode")
  language             String  @default("en")
  user                 User    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_settings")
}

model CustomerProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique @map("user_id")
  // INDIVIDUAL | MECHANIC | FLEET_MANAGER
  profileType   String   @default("INDIVIDUAL") @map("profile_type")
  walletBalance Decimal  @default(0) @map("wallet_balance") @db.Decimal(10, 2)
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  totalOrders   Int      @default(0) @map("total_orders")
  totalSpent    Decimal  @default(0) @map("total_spent") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("customer_profiles")
}

model CustomerAddress {
  addressId Int                @id @default(autoincrement()) @map("address_id")
  userId    Int                @map("user_id")
  label     String             @default("Home")
  fullName  String             @map("full_name")
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  latitude  Decimal?           @db.Decimal(9, 6)
  longitude Decimal?           @db.Decimal(9, 6)
  isDefault Boolean            @default(false) @map("is_default")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  user      User               @relation(fields: [userId], references: [userId], onDelete: Cascade)
  orders    MarketplaceOrder[]

  @@index([userId])
  @@map("customer_addresses")
}

model CustomerVehicle {
  id             Int                @id @default(autoincrement())
  userId         Int                @map("user_id")
  vehicleId      Int?               @map("vehicle_id")
  nickname       String?
  make           String
  model          String
  variant        String?
  year           Int
  fuelType       String?            @map("fuel_type")
  registrationNo String?            @map("registration_no")
  purchaseYear   Int?               @map("purchase_year")
  isDefault      Boolean            @default(false) @map("is_default")
  createdAt      DateTime           @default(now()) @map("created_at")
  user           User               @relation(fields: [userId], references: [userId], onDelete: Cascade)
  vehicle        Vehicle?           @relation(fields: [vehicleId], references: [vehicleId])
  orders         MarketplaceOrder[]

  @@index([userId])
  @@map("customer_vehicles")
}

model AdminProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  // SUPER_ADMIN | OPS | SUPPORT | FINANCE
  adminRole   String   @default("SUPPORT") @map("admin_role")
  department  String?
  permissions Json     @default("[]")
  ipWhitelist String[] @default([]) @map("ip_whitelist")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("admin_profiles")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SHOP & STAFF
// ═══════════════════════════════════════════════════════════════════════════════

model Shop {
  shopId            Int       @id @default(autoincrement()) @map("shop_id")
  name              String
  ownerName         String?   @map("owner_name")
  phone             String    @unique
  email             String?
  gstin             String?
  panNumber         String?   @map("pan_number")
  // 2-digit GST state code (e.g. "36" for Telangana) — used to split CGST+SGST vs IGST
  stateCode         String?   @map("state_code")
  address           String?
  city              String?
  state             String?
  pincode           String?
  latitude          Decimal?  @db.Decimal(9, 6)
  longitude         Decimal?  @db.Decimal(9, 6)
  deliveryRadiusKm  Int?      @default(10) @map("delivery_radius_km")
  shopDescription   String?   @map("shop_description")
  // shopCategory: AUTO_PARTS | WORKSHOP | BOTH | TYRES | ELECTRICAL | GENERAL
  shopCategory      String?   @map("shop_category")
  whatsappNumber    String?   @map("whatsapp_number")
  // JSON array: [{ day: "Mon-Fri", open: "09:00", close: "18:00" }]
  operatingHours    Json?     @map("operating_hours")
  photoUrl          String?   @map("photo_url")
  logoUrl           String?   @map("logo_url")
  // Bank details for marketplace payouts
  bankAccountNumber String?   @map("bank_account_number")
  bankIfsc          String?   @map("bank_ifsc")
  bankAccountName   String?   @map("bank_account_name")
  isVerified        Boolean   @default(false) @map("is_verified")
  isActive          Boolean   @default(true) @map("is_active")
  // FREE | STARTER | PRO | ENTERPRISE
  plan              String    @default("FREE")
  planExpiresAt     DateTime? @map("plan_expires_at")
  // Days a customer has to return an item — used to flag (not block) out-of-policy returns
  returnPolicyDays  Int       @default(30) @map("return_policy_days")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  users              User[]
  shopUsers          ShopUser[]
  inventory          ShopInventory[]
  movements          Movement[]
  invoices           Invoice[]
  purchaseOrders     PurchaseOrder[]
  parties            Party[]
  partyLedger        PartyLedger[]
  jobCards           JobCard[]
  marketplaceOrders  MarketplaceOrder[]
  confirmFitRequests ConfirmFitRequest[]
  purchaseBills      PurchaseBill[]
  numberCounters     NumberCounter[]
  batches            StockBatch[]
  salesReturns       SalesReturn[]
  creditNotes        CreditNote[]
  purchaseReturns    PurchaseReturn[]
  exchangeOrders     ExchangeOrder[]
  warrantyClaims     WarrantyClaim[]

  @@map("shops")
}

// Supplier invoices uploaded by shop owners (OCR/parse → review → stock-in).
// `extracted` keeps the full parse result so the bill can be re-reviewed later.
model PurchaseBill {
  billId        Int       @id @default(autoincrement()) @map("bill_id")
  shopId        Int       @map("shop_id")
  fileUrl       String?   @map("file_url")
  fileName      String?   @map("file_name")
  supplierName  String?   @map("supplier_name")
  supplierGstin String?   @map("supplier_gstin")
  invoiceNumber String?   @map("invoice_number")
  invoiceDate   String?   @map("invoice_date")
  taxableTotal  Decimal?  @map("taxable_total") @db.Decimal(12, 2)
  grandTotal    Decimal?  @map("grand_total") @db.Decimal(12, 2)
  itemCount     Int       @default(0) @map("item_count")
  extracted     Json?
  sumMatches    Boolean   @default(false) @map("sum_matches")
  status        String    @default("PENDING_REVIEW") // PENDING_REVIEW | IMPORTED
  importedAt    DateTime? @map("imported_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  shop                 Shop             @relation(fields: [shopId], references: [shopId])
  linkedPurchaseOrders PurchaseOrder[]
  purchaseReturns      PurchaseReturn[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@map("purchase_bills")
}

model ShopUser {
  id           Int       @id @default(autoincrement())
  shopId       Int       @map("shop_id")
  userId       Int       @map("user_id")
  // OWNER | MANAGER | CASHIER | MECHANIC | DELIVERY
  role         String    @default("CASHIER")
  permissions  Json      @default("{}")
  invitedBy    String?   @map("invited_by")
  isActive     Boolean   @default(true) @map("is_active")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  lastActiveAt DateTime? @map("last_active_at")
  shop         Shop      @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@map("shop_users")
}

// ═══════════════════════════════════════════════════════════════════════════════
// VEHICLE & PARTS CATALOG
// ═══════════════════════════════════════════════════════════════════════════════

// ─── VEHICLE MANUFACTURER ─────────────────────────────────────────────────────
// One row per brand/OEM — Maruti Suzuki, Hero MotoCorp, Tata Motors, VECV, etc.
// A single manufacturer can span multiple vehicle types (Tata: car + commercial;
// Mahindra: car + commercial + tractor).  vehicleTypes is a Postgres string[] so
// the frontend can filter makes by type without a join.
model VehicleManufacturer {
  manufacturerId Int      @id @default(autoincrement()) @map("manufacturer_id")
  name           String   @unique // "Maruti Suzuki"
  slug           String   @unique // "maruti-suzuki"
  parentGroup    String?  @map("parent_group") // "Suzuki Group", "Tata Group"
  country        String   @default("India")
  // Postgres text[]: ["car","2wheeler","commercial","tractor"]
  vehicleTypes   String[] @default([]) @map("vehicle_types")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  models VehicleModel[]

  @@map("vehicle_manufacturers")
}

// ─── VEHICLE MODEL ────────────────────────────────────────────────────────────
// One row per nameplate — Swift, Nexon, Splendor, Activa, Eicher Pro 2049, etc.
// yearTo = null  →  model still in production.
// The frontend year-picker iterates yearFrom..min(yearTo, currentYear).
model VehicleModel {
  modelId        Int      @id @default(autoincrement()) @map("model_id")
  manufacturerId Int      @map("manufacturer_id")
  name           String // "Swift", "Nexon"
  slug           String // "swift", "nexon"
  // Legacy string — kept for fast querying without join
  // car | 2wheeler | commercial | tractor
  vehicleType    String   @map("vehicle_type")
  // FK → vehicle_types.vehicle_type_id (structured; null until backfill runs)
  vehicleTypeId  Int?     @map("vehicle_type_id")
  // Legacy string — kept for backward compat
  // hatchback | sedan | suv | mpv | pickup | motorcycle | scooter
  // mini-truck | truck | bus | van | 3-wheeler | tractor
  bodyType       String?  @map("body_type")
  // FK → vehicle_body_types.body_type_id (structured; null until backfill runs)
  bodyTypeId     Int?     @map("body_type_id")
  yearFrom       Int      @map("year_from")
  yearTo         Int?     @map("year_to")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  manufacturer   VehicleManufacturer @relation(fields: [manufacturerId], references: [manufacturerId])
  vehicleTypeRef VehicleType?        @relation(fields: [vehicleTypeId], references: [id])
  bodyTypeRef    VehicleBodyType?    @relation(fields: [bodyTypeId], references: [bodyTypeId])
  vehicles       Vehicle[]

  @@unique([manufacturerId, name])
  @@index([manufacturerId])
  @@index([vehicleType])
  @@index([vehicleTypeId])
  @@index([bodyTypeId])
  @@map("vehicle_models")
}

// ─── VEHICLE TYPE MASTER TABLE ────────────────────────────────────────────────
// Seeded from VEHICLE_TYPES constant in frontend; also used in admin import dropdown.
// Car, Motorcycle/2-Wheeler, Commercial Vehicle, Tractor, Auto Rickshaw, EV
model VehicleType {
  id        Int      @id @default(autoincrement()) @map("vehicle_type_id")
  name      String   @unique // e.g. "Car / Passenger Vehicle"
  slug      String   @unique // e.g. "car"
  icon      String? // e.g. "🚗"
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  vehicles      Vehicle[]
  vehicleModels VehicleModel[]
  bodyTypes     VehicleBodyType[]

  @@map("vehicle_types")
}

// ─── VEHICLE BODY TYPE ────────────────────────────────────────────────────────
// One row per body style per vehicle type.
//   Car:        hatchback | sedan | suv | mpv | crossover | coupe | van | pickup
//   2-Wheeler:  motorcycle | scooter | moped
//   Commercial: mini-truck | truck | bus | pickup | van (cargo)
//   Tractor:    tractor | mini-tractor | power-tiller | harvester
//   Auto Rick:  3-wheeler | e-rickshaw
//   EV:         electric-car | electric-scooter | electric-motorcycle | etc.
model VehicleBodyType {
  bodyTypeId    Int      @id @default(autoincrement()) @map("body_type_id")
  vehicleTypeId Int      @map("vehicle_type_id") // FK → vehicle_types.vehicle_type_id
  name          String // "Hatchback", "SUV"
  slug          String   @unique // "hatchback", "suv"
  icon          String? // "🚗", "🏍️"
  description   String?
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  vehicleType   VehicleType    @relation(fields: [vehicleTypeId], references: [id])
  vehicles      Vehicle[]
  vehicleModels VehicleModel[]

  @@index([vehicleTypeId])
  @@map("vehicle_body_types")
}

model Vehicle {
  vehicleId     Int      @id @default(autoincrement()) @map("vehicle_id")
  make          String
  model         String
  variant       String?
  yearFrom      Int      @map("year_from")
  yearTo        Int?     @map("year_to")
  fuelType      String?  @map("fuel_type")
  engineCc      Int?     @map("engine_cc")
  engineCode    String?  @map("engine_code")
  transmission  String?
  // Legacy string — kept for fast querying without join
  bodyType      String?  @map("body_type")
  // FK → vehicle_body_types.body_type_id (structured; null until backfill runs)
  bodyTypeId    Int?     @map("body_type_id")
  // Legacy string kept for compat ("Car", "Motorcycle", …)
  vehicleType   String   @default("Car") @map("vehicle_type")
  vehicleTypeId Int?     @map("vehicle_type_id") // FK → vehicle_types
  // FK to VehicleModel — set during seeding & when shop confirms a new fitment
  modelId       Int?     @map("model_id")
  absEquipped   Boolean  @default(false) @map("abs_equipped")
  createdAt     DateTime @default(now()) @map("created_at")

  vehicleTypeRef  VehicleType?     @relation(fields: [vehicleTypeId], references: [id])
  bodyTypeRef     VehicleBodyType? @relation(fields: [bodyTypeId], references: [bodyTypeId])
  vehicleModelRef VehicleModel?    @relation(fields: [modelId], references: [modelId])

  fitments           PartFitment[]
  customerVehicles   CustomerVehicle[]
  confirmFitRequests ConfirmFitRequest[]

  @@index([make, model])
  @@index([vehicleTypeId])
  @@index([bodyTypeId])
  @@map("vehicles")
}

model MasterPart {
  masterPartId        Int       @id @default(autoincrement()) @map("master_part_id")
  partName            String    @map("part_name")
  brand               String?
  categoryL1          String?   @map("category_l1")
  categoryL2          String?   @map("category_l2")
  categoryL3          String?   @map("category_l3")
  // Primary OEM part number (first/canonical — rest go in oemNumbers array)
  primaryOemNumber    String?   @unique @map("primary_oem_number")
  oemNumbers          String[]  @default([]) @map("oem_numbers")
  barcodes            String[]  @default([]) @map("barcodes")
  hsnCode             String?   @map("hsn_code")
  gstRate             Decimal   @default(18.00) @map("gst_rate") @db.Decimal(5, 2)
  unitOfSale          String    @default("Piece") @map("unit_of_sale")
  weightGrams         Int?      @map("weight_grams")
  description         String?
  specifications      Json?
  imageUrl            String?   @map("image_url")
  images              String?
  // OEM = Original Equipment Manufacturer part; OES = Original Equipment Supplier (aftermarket)
  partType            String    @default("OEM") @map("part_type")
  isUniversal         Boolean   @default(false) @map("is_universal")
  requiresFitment     Boolean   @default(true) @map("requires_fitment")
  // Nullable — unset for virtually every catalog row today (never populated on bulk import).
  // Null means "unknown", not "no warranty" — warranty claim creation treats it permissively
  // (flags days-since-sale for staff judgment, never blocks) rather than against a false null.
  warrantyMonths      Int?      @map("warranty_months")
  status              String    @default("PENDING")
  source              String    @default("MANUAL")
  // Shop that first contributed this part to the catalog
  contributedByShopId Int?      @map("contributed_by_shop_id")
  verifiedAt          DateTime? @map("verified_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  fitments           PartFitment[]
  inventory          ShopInventory[]
  reviews            MarketplaceReview[]
  confirmFitRequests ConfirmFitRequest[]

  @@index([partName])
  @@index([brand])
  @@index([categoryL1]) // category browse — GET /marketplace/browse?category=
  @@index([status]) // admin catalog filtering by PENDING / VERIFIED / REJECTED
  @@map("master_parts")
}

model PartFitment {
  fitmentId    Int      @id @default(autoincrement()) @map("fitment_id")
  masterPartId Int      @map("master_part_id")
  vehicleId    Int      @map("vehicle_id")
  // EXACT | COMPATIBLE | UNIVERSAL
  fitType      String   @map("fit_type")
  // verified | shop_confirmed | unverified
  confidence   String   @default("unverified")
  position     String?
  // SHOP_CONFIRMED | USER_REPORTED | OEM | SYSTEM
  source       String   @default("SHOP_CONFIRMED")
  notes        String?
  // userId of the staff member / admin who verified this fitment
  verifiedBy   Int?     @map("verified_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  masterPart         MasterPart          @relation(fields: [masterPartId], references: [masterPartId], onDelete: Cascade)
  vehicle            Vehicle             @relation(fields: [vehicleId], references: [vehicleId], onDelete: Cascade)
  confirmFitRequests ConfirmFitRequest[]

  @@unique([masterPartId, vehicleId])
  @@index([vehicleId])
  @@index([masterPartId])
  @@map("part_fitments")
}

model ConfirmFitRequest {
  id           Int  @id @default(autoincrement())
  userId       Int  @map("user_id")
  masterPartId Int  @map("master_part_id")
  shopId       Int  @map("shop_id")
  vehicleId    Int? @map("vehicle_id")

  // Vehicle info captured from user
  make     String
  model    String
  variant  String?
  year     Int
  fuelType String? @map("fuel_type")
  regNo    String? @map("reg_no")
  userNote String? @map("user_note")

  // Shop resolution
  // PENDING | CONFIRMED | REJECTED
  status     String    @default("PENDING")
  shopNote   String?   @map("shop_note")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy Int?      @map("resolved_by")

  // Once shop confirms, auto-save to PartFitment
  savedToFitments Boolean @default(false) @map("saved_to_fitments")
  fitmentId       Int?    @map("fitment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User         @relation(fields: [userId], references: [userId])
  masterPart MasterPart   @relation(fields: [masterPartId], references: [masterPartId])
  shop       Shop         @relation(fields: [shopId], references: [shopId])
  vehicle    Vehicle?     @relation(fields: [vehicleId], references: [vehicleId])
  fitment    PartFitment? @relation(fields: [fitmentId], references: [fitmentId])

  @@index([userId])
  @@index([shopId])
  @@index([masterPartId])
  @@index([shopId, status])
  @@map("confirm_fit_requests")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SHOP INVENTORY & STOCK LEDGER
// ═══════════════════════════════════════════════════════════════════════════════

model ShopInventory {
  inventoryId         Int        @id @default(autoincrement()) @map("inventory_id")
  shopId              Int        @map("shop_id")
  masterPartId        Int        @map("master_part_id")
  sellingPrice        Decimal    @map("selling_price") @db.Decimal(10, 2)
  buyingPrice         Decimal?   @map("buying_price") @db.Decimal(10, 2)
  stockQty            Int        @default(0) @map("stock_qty")
  // Returned units confirmed damaged/unsellable — separate bucket from stockQty so a shop
  // can carry both sellable and damaged units of the same part at once. Never shown in
  // customer-facing search or POS; only cleared via a future scrap/write-off action.
  damagedQty          Int        @default(0) @map("damaged_qty")
  version             Int        @default(0) @map("version")
  reservedQty         Int        @default(0) @map("reserved_qty")
  minStockAlert       Int        @default(5) @map("min_stock_alert")
  maxStockLevel       Int?       @map("max_stock_level")
  rackLocation        String?    @map("rack_location")
  // Shop's own name override for the part (if different from MasterPart.partName)
  customPartName      String?    @map("custom_part_name")
  // Shop-specific barcode (sticker/label printed in-store)
  barcode             String?
  shopSpecificNotes   String?    @map("shop_specific_notes")
  // Shop's own product photo (Cloudinary) — falls back to MasterPart.imageUrl
  imageUrl            String?    @map("image_url")
  // Up to 3 shop product photos, stored as a JSON string array of URLs.
  // imageUrl stays the primary/first photo for back-compat.
  images              String?
  // Shop-level overrides for category and emoji icon (independent of MasterPart)
  customCategoryL1    String?    @map("custom_category_l1")
  customIcon          String?    @map("custom_icon")
  isMarketplaceListed Boolean    @default(false) @map("is_marketplace_listed")
  lastPurchasedAt     DateTime?  @map("last_purchased_at")
  lastSoldAt          DateTime?  @map("last_sold_at")
  deletedAt           DateTime?  @map("deleted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  shop                Shop       @relation(fields: [shopId], references: [shopId])
  masterPart          MasterPart @relation(fields: [masterPartId], references: [masterPartId])

  movements             Movement[]
  invoiceItems          InvoiceItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  jobCardItems          JobCardItem[]
  marketplaceOrderItems MarketplaceOrderItem[]
  reviews               MarketplaceReview[]
  batches               StockBatch[]
  salesReturnItems      SalesReturnItem[]
  purchaseReturnItems   PurchaseReturnItem[]
  warrantyClaims        WarrantyClaim[]

  @@unique([shopId, masterPartId])
  @@index([shopId])
  @@index([shopId, isMarketplaceListed]) // marketplace browse — hot path, filters listed + shopId together
  @@index([shopId, stockQty]) // low-stock alerts
  @@map("shop_inventory")
}

// Vehicles a shop registers (customers' cars it services). Scoped to the shop;
// ownerId references a Party (the customer). Used to create job cards.
model ShopVehicle {
  vehicleId          Int      @id @default(autoincrement()) @map("vehicle_id")
  shopId             Int      @map("shop_id")
  ownerId            Int?     @map("owner_id") // -> Party.partyId (customer)
  make               String
  model              String
  variant            String?
  year               Int?
  fuelType           String?  @map("fuel_type")
  registrationNumber String?  @map("registration_number")
  engineType         String?  @map("engine_type")
  odometer           Int?
  vin                String?
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  owner Party? @relation(fields: [ownerId], references: [partyId], onDelete: SetNull)

  @@index([shopId])
  @@map("shop_vehicles")
}

// Immutable stock ledger — INSERT ONLY, never UPDATE or DELETE rows.
model Movement {
  movementId      Int      @id @default(autoincrement()) @map("movement_id")
  shopId          Int      @map("shop_id")
  inventoryId     Int?     @map("inventory_id")
  createdBy       Int?     @map("created_by")
  type            String
  qty             Int
  unitPrice       Decimal? @map("unit_price") @db.Decimal(10, 2)
  gstRate         Decimal? @map("gst_rate") @db.Decimal(5, 2)
  taxableAmount   Decimal? @map("taxable_amount") @db.Decimal(10, 2)
  totalAmount     Decimal? @map("total_amount") @db.Decimal(10, 2)
  gstAmount       Decimal? @map("gst_amount") @db.Decimal(10, 2)
  profit          Decimal? @db.Decimal(10, 2)
  invoiceId       Int?     @map("invoice_id")
  partyId         Int?     @map("party_id")
  // External reference: bill number, PO number, challan number, etc.
  referenceNumber String?  @map("reference_number")
  // Denormalized display fields — snapshot at creation, avoids extra joins on history queries
  invoiceNumber   String?  @map("invoice_number")
  partyName       String?  @map("party_name")
  paymentMode     String?  @map("payment_mode")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  correlationId   String?  @map("correlation_id")
  causationId     Int?     @map("causation_id")

  shop      Shop           @relation(fields: [shopId], references: [shopId])
  inventory ShopInventory? @relation(fields: [inventoryId], references: [inventoryId])
  creator   User?          @relation("MovementCreatedBy", fields: [createdBy], references: [userId])
  invoice   Invoice?       @relation(fields: [invoiceId], references: [invoiceId])
  party     Party?         @relation(fields: [partyId], references: [partyId])

  purchaseReturnItems PurchaseReturnItem[]

  @@index([shopId, createdAt(sort: Desc)])
  @@index([inventoryId])
  @@index([inventoryId, createdAt(sort: Desc)]) // composite for WHERE inventoryId + ORDER BY createdAt
  @@index([partyId]) // supplier/customer ledger queries
  @@index([shopId, type]) // movement type reporting (SALE / PURCHASE / RETURN breakdown)
  @@index([invoiceId]) // invoice detail — all movements for an invoice
  @@map("movements")
}

model StockBatch {
  batchId      Int       @id @default(autoincrement()) @map("batch_id")
  shopId       Int       @map("shop_id")
  inventoryId  Int       @map("inventory_id")
  batchNumber  String?   @map("batch_number")
  serialNumber String?   @map("serial_number")
  qtyReceived  Int       @map("qty_received")
  qtyRemaining Int       @map("qty_remaining")
  costPrice    Decimal   @map("cost_price") @db.Decimal(10, 2)
  supplierName String?   @map("supplier_name")
  partyId      Int?      @map("party_id")
  receivedDate DateTime  @default(now()) @map("received_date")
  expiryDate   DateTime? @map("expiry_date")
  notes        String?
  poId         Int?      @map("po_id")
  // Per-lot/serial status — meaningful for serial-tracked stock, where a status flag
  // (unlike a bulk quantity bucket) correctly represents one physical unit's state.
  // AVAILABLE | DAMAGED | WARRANTY | RETURNED_TO_SUPPLIER | SCRAPPED
  status       String    @default("AVAILABLE")
  createdAt    DateTime  @default(now()) @map("created_at")

  shop      Shop          @relation(fields: [shopId], references: [shopId])
  inventory ShopInventory @relation(fields: [inventoryId], references: [inventoryId])

  warrantyClaims WarrantyClaim[]

  @@index([shopId, inventoryId])
  @@index([shopId, batchNumber])
  @@map("stock_batches")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PARTIES (CUSTOMERS & SUPPLIERS)
// ═══════════════════════════════════════════════════════════════════════════════

model Party {
  partyId     Int       @id @default(autoincrement()) @map("party_id")
  shopId      Int       @map("shop_id")
  name        String
  phone       String?
  email       String?
  gstin       String?
  address     String?
  type        String    @default("CUSTOMER")
  creditLimit Decimal   @default(0) @map("credit_limit") @db.Decimal(10, 2)
  // Number of days credit is allowed before it becomes overdue
  creditDays  Int       @default(30) @map("credit_days")
  outstanding Decimal   @default(0) @db.Decimal(10, 2)
  notes       String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  version     Int       @default(0) @map("version")
  shop        Shop      @relation(fields: [shopId], references: [shopId])

  invoices        Invoice[]
  movements       Movement[]
  purchaseOrders  PurchaseOrder[]
  ledgerEntries   PartyLedger[]
  shopVehicles    ShopVehicle[]
  salesReturns    SalesReturn[]
  creditNotes     CreditNote[]
  purchaseReturns PurchaseReturn[]
  warrantyClaims  WarrantyClaim[]

  @@index([shopId])
  @@index([shopId, type]) // filter CUSTOMER vs SUPPLIER
  @@map("parties")
}

// Udhaar ledger — immutable credit/debit trail per party.
// Every credit sale, payment received, and adjustment creates a row here.
model PartyLedger {
  ledgerId     Int      @id @default(autoincrement()) @map("ledger_id")
  shopId       Int      @map("shop_id")
  partyId      Int      @map("party_id")
  // SALE_CREDIT | PAYMENT_RECEIVED | RETURN_CREDIT | CREDIT_NOTE_APPLIED | ADJUSTMENT | OPENING_BALANCE
  entryType    String   @map("entry_type")
  // Positive = amount party owes shop (debit); Negative = shop owes party (credit)
  debitAmount  Decimal  @default(0) @map("debit_amount") @db.Decimal(10, 2)
  creditAmount Decimal  @default(0) @map("credit_amount") @db.Decimal(10, 2)
  // Running balance after this entry (positive = party owes shop)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(10, 2)
  invoiceId    Int?     @map("invoice_id")
  referenceNo  String?  @map("reference_no")
  notes        String?
  // Staff member who recorded this entry
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  shop    Shop     @relation(fields: [shopId], references: [shopId])
  party   Party    @relation(fields: [partyId], references: [partyId])
  invoice Invoice? @relation(fields: [invoiceId], references: [invoiceId])

  @@index([partyId, createdAt(sort: Desc)])
  @@index([shopId, createdAt(sort: Desc)])
  @@map("party_ledger")
}

// ═══════════════════════════════════════════════════════════════════════════════
// INVOICES (SALES BILLING)
// ═══════════════════════════════════════════════════════════════════════════════

model Invoice {
  invoiceId          Int       @id @default(autoincrement()) @map("invoice_id")
  invoiceNumber      String    @unique @map("invoice_number")
  shopId             Int       @map("shop_id")
  partyId            Int?      @map("party_id")
  createdBy          Int?      @map("created_by")
  // RETAIL | CREDIT | ESTIMATE | RETURN | WORKSHOP
  invoiceType        String    @default("RETAIL") @map("invoice_type")
  partyName          String?   @map("party_name")
  partyPhone         String?   @map("party_phone")
  partyGstin         String?   @map("party_gstin")
  // Separate billing address (if different from party address)
  billingAddress     String?   @map("billing_address")
  subtotal           Decimal   @db.Decimal(10, 2)
  discountAmount     Decimal   @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxableAmount      Decimal   @map("taxable_amount") @db.Decimal(10, 2)
  cgst               Decimal   @db.Decimal(10, 2)
  sgst               Decimal   @db.Decimal(10, 2)
  igst               Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal   @map("total_amount") @db.Decimal(10, 2)
  paymentMode        String    @map("payment_mode")
  cashAmount         Decimal?  @map("cash_amount") @db.Decimal(10, 2)
  upiAmount          Decimal?  @map("upi_amount") @db.Decimal(10, 2)
  creditAmount       Decimal?  @map("credit_amount") @db.Decimal(10, 2)
  paidAmount         Decimal   @default(0) @map("paid_amount") @db.Decimal(10, 2)
  // True when full or partial credit was extended (links to PartyLedger)
  isCreditSale       Boolean   @default(false) @map("is_credit_sale")
  // Set when this invoice was generated from a marketplace order
  marketplaceOrderId Int?      @map("marketplace_order_id")
  // UPI transaction reference ID captured at POS
  upiReference       String?   @map("upi_reference")
  pdfUrl             String?   @map("pdf_url")
  // Timestamp when the PDF/link was sent via WhatsApp
  whatsappSentAt     DateTime? @map("whatsapp_sent_at")
  status             String    @default("PAID")
  notes              String?
  // JSON snapshot of non-inventory line items (services, labour, ad-hoc charges) sold in this invoice.
  // InvoiceItem.inventoryId is non-nullable, so custom items cannot be stored as rows there.
  customItemsMeta    Json?     @map("custom_items_meta")
  createdAt          DateTime  @default(now()) @map("created_at")
  version            Int       @default(0) @map("version")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  shop           Shop             @relation(fields: [shopId], references: [shopId])
  party          Party?           @relation(fields: [partyId], references: [partyId])
  creator        User?            @relation("InvoiceCreatedBy", fields: [createdBy], references: [userId])
  items          InvoiceItem[]
  movements      Movement[]
  payments       InvoicePayment[]
  ledgerEntries  PartyLedger[]
  salesReturns   SalesReturn[]
  creditNotes    CreditNote[]
  exchangeOrder  ExchangeOrder?
  warrantyClaims WarrantyClaim[]

  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, status]) // filter PAID / CREDIT / ESTIMATE invoices
  @@index([partyId]) // party invoice history
  @@index([marketplaceOrderId]) // customer invoice lookup + PDF access check
  @@map("invoices")
}

model InvoiceItem {
  itemId      Int     @id @default(autoincrement()) @map("item_id")
  invoiceId   Int     @map("invoice_id")
  inventoryId Int     @map("inventory_id")
  partName    String  @map("part_name")
  brand       String?
  hsnCode     String? @map("hsn_code")
  qty         Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  taxableAmt  Decimal @map("taxable_amt") @db.Decimal(10, 2)
  gstRate     Decimal @map("gst_rate") @db.Decimal(5, 2)
  cgst        Decimal @db.Decimal(10, 2)
  sgst        Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice   Invoice       @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  inventory ShopInventory @relation(fields: [inventoryId], references: [inventoryId])

  salesReturnItems SalesReturnItem[]
  warrantyClaims   WarrantyClaim[]

  @@index([invoiceId])
  @@index([inventoryId])
  @@map("invoice_items")
}

model InvoicePayment {
  id         Int      @id @default(autoincrement())
  invoiceId  Int      @map("invoice_id")
  amount     Decimal  @db.Decimal(10, 2)
  mode       String
  reference  String?
  note       String?
  receivedAt DateTime @default(now()) @map("received_at")
  invoice    Invoice  @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_payments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SALES RETURNS & CREDIT NOTES
//
// Design: every return is linked to an original Invoice — never freestanding.
// Stock changes go through the existing `Movement` ledger (new `type` values:
// SALES_RETURN_IN, SALES_RETURN_DAMAGED) rather than a parallel movements table,
// so History/Reports keep working unmodified. Customer refund-as-credit reuses
// the existing PartyLedger/Party.outstanding mechanism (entryType RETURN_CREDIT) —
// there is no separate "wallet" table; a negative `outstanding` IS the wallet.
// ═══════════════════════════════════════════════════════════════════════════════

model SalesReturn {
  returnId          Int      @id @default(autoincrement()) @map("return_id")
  returnNo          String   @unique @map("return_no") // RET-S{shopId}-{FY}-NNNNN
  shopId            Int      @map("shop_id")
  originalInvoiceId Int      @map("original_invoice_id")
  partyId           Int?     @map("party_id")
  // WRONG_PART | DEFECTIVE | WARRANTY | CHANGED_MIND | OTHER
  reason            String
  // Flagged (not blocked) when outside Shop.returnPolicyDays — manager can still approve
  requiresApproval  Boolean  @default(false) @map("requires_approval")
  approvedBy        Int?     @map("approved_by")
  // PENDING_APPROVAL | COMPLETED | CANCELLED
  status            String   @default("COMPLETED")
  // CASH | UPI | BANK | STORE_CREDIT — how the customer was made whole
  refundMode        String?  @map("refund_mode")
  creditNoteId      Int?     @unique @map("credit_note_id")
  notes             String?
  createdBy         Int?     @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  shop          Shop              @relation(fields: [shopId], references: [shopId])
  invoice       Invoice           @relation(fields: [originalInvoiceId], references: [invoiceId])
  party         Party?            @relation(fields: [partyId], references: [partyId])
  items         SalesReturnItem[]
  creditNote    CreditNote?       @relation(fields: [creditNoteId], references: [creditNoteId])
  exchangeOrder ExchangeOrder?
  creator       User?             @relation("SalesReturnCreatedBy", fields: [createdBy], references: [userId])

  @@index([shopId, createdAt(sort: Desc)])
  @@index([originalInvoiceId])
  @@index([partyId])
  @@map("sales_returns")
}

model SalesReturnItem {
  itemId        Int     @id @default(autoincrement()) @map("item_id")
  returnId      Int     @map("return_id")
  inventoryId   Int     @map("inventory_id")
  // Ties back to the exact original line — enforces "can't return more than was sold" per line
  invoiceItemId Int     @map("invoice_item_id")
  qty           Int
  // SEALED | GOOD | DAMAGED | USED
  condition     String
  // RESELLABLE (→ stockQty) | DAMAGED_STOCK (→ damagedQty)
  disposition   String
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  taxableValue  Decimal @map("taxable_value") @db.Decimal(10, 2)
  gstRate       Decimal @map("gst_rate") @db.Decimal(5, 2)
  cgst          Decimal @db.Decimal(10, 2)
  sgst          Decimal @db.Decimal(10, 2)
  igst          Decimal @default(0) @db.Decimal(10, 2)

  return      SalesReturn   @relation(fields: [returnId], references: [returnId], onDelete: Cascade)
  inventory   ShopInventory @relation(fields: [inventoryId], references: [inventoryId])
  invoiceItem InvoiceItem   @relation(fields: [invoiceItemId], references: [itemId])

  @@index([returnId])
  @@index([invoiceItemId]) // sum-returned-so-far check per invoice line
  @@map("sales_return_items")
}

// Exchange = a SalesReturn (old item, always settled as store credit) + a normal
// Invoice (new item) that immediately redeems that credit note. No separate ledger
// or pricing engine here — it's pure orchestration over what already exists.
// Both legs' Movement rows share correlationId = exchangeNo so they can be
// reconstructed as one event without a join through this table.
model ExchangeOrder {
  exchangeId      Int      @id @default(autoincrement()) @map("exchange_id")
  exchangeNo      String   @unique @map("exchange_no") // EXC-S{shopId}-{FY}-NNNNN
  shopId          Int      @map("shop_id")
  salesReturnId   Int      @unique @map("sales_return_id")
  newInvoiceId    Int      @unique @map("new_invoice_id")
  priceDifference Decimal  @map("price_difference") @db.Decimal(10, 2) // new taxable − old taxable
  gstDifference   Decimal  @map("gst_difference") @db.Decimal(10, 2)
  // positive = customer owed the shop more; negative = shop owed the customer a refund
  netAmount       Decimal  @map("net_amount") @db.Decimal(10, 2)
  // COLLECT (customer paid more) | REFUND (customer paid less) | EVEN
  settlementType  String   @map("settlement_type")
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  shop        Shop        @relation(fields: [shopId], references: [shopId])
  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [returnId])
  newInvoice  Invoice     @relation(fields: [newInvoiceId], references: [invoiceId])

  @@index([shopId, createdAt(sort: Desc)])
  @@map("exchange_orders")
}

// ═══════════════════════════════════════════════════════════════════════════════
// WARRANTY CLAIMS
//
// Differs from a Sales Return: the item isn't simply refunded — it moves through
// a claim lifecycle (Sent to Supplier → Approved/Rejected → Replacement Received
// → Returned to Customer) before resolution. Status evolves over days/weeks, so
// it uses optimistic `version` locking like PurchaseReturn.resolution. Stock only
// moves at REPLACEMENT_RECEIVED (in) and RETURNED_TO_CUSTOMER (out) — the claimed
// unit itself was never part of counted stock (it left at the original sale) and
// isn't added back, since it's neither sellable nor sitting in the shop's own
// damaged bin while a third party (the OEM) has it.
// ═══════════════════════════════════════════════════════════════════════════════

model WarrantyClaim {
  claimId           Int       @id @default(autoincrement()) @map("claim_id")
  claimNo           String    @unique @map("claim_no") // WC-S{shopId}-{FY}-NNNNN
  shopId            Int       @map("shop_id")
  originalInvoiceId Int       @map("original_invoice_id")
  invoiceItemId     Int       @map("invoice_item_id")
  inventoryId       Int       @map("inventory_id")
  batchId           Int?      @map("batch_id") // set when the claimed unit is serial/batch-tracked
  qty               Int       @default(1)
  // SENT_TO_SUPPLIER | APPROVED | REJECTED | REPLACEMENT_RECEIVED | RETURNED_TO_CUSTOMER
  status            String    @default("SENT_TO_SUPPLIER")
  partyId           Int?      @map("party_id") // supplier/OEM, if registered as a Party
  sentDate          DateTime  @default(now()) @map("sent_date")
  resolvedDate      DateTime? @map("resolved_date")
  notes             String?
  // Optimistic lock — status is updated later via PATCH, days/weeks after creation
  version           Int       @default(0)
  createdBy         Int?      @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")

  shop        Shop          @relation(fields: [shopId], references: [shopId])
  invoice     Invoice       @relation(fields: [originalInvoiceId], references: [invoiceId])
  invoiceItem InvoiceItem   @relation(fields: [invoiceItemId], references: [itemId])
  inventory   ShopInventory @relation(fields: [inventoryId], references: [inventoryId])
  batch       StockBatch?   @relation(fields: [batchId], references: [batchId])
  party       Party?        @relation(fields: [partyId], references: [partyId])

  @@index([shopId, status])
  @@index([originalInvoiceId])
  @@map("warranty_claims")
}

model CreditNote {
  creditNoteId      Int      @id @default(autoincrement()) @map("credit_note_id")
  creditNoteNo      String   @unique @map("credit_note_no") // CN-S{shopId}-{FY}-NNNNN
  shopId            Int      @map("shop_id")
  // GST | COMMERCIAL — see Section 34 CGST Act deadline logic in src/lib/gst-fy.js
  type              String
  linkedInvoiceId   Int      @map("linked_invoice_id")
  partyId           Int?     @map("party_id")
  issueDate         DateTime @default(now()) @map("issue_date")
  taxableValue      Decimal  @map("taxable_value") @db.Decimal(10, 2)
  cgst              Decimal  @db.Decimal(10, 2)
  sgst              Decimal  @db.Decimal(10, 2)
  igst              Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal  @map("total_amount") @db.Decimal(10, 2)
  // UNUSED | PARTIALLY_USED | FULLY_USED | REFUNDED
  status            String   @default("UNUSED")
  remainingBalance  Decimal  @map("remaining_balance") @db.Decimal(10, 2)
  // "YYYY-MM" — set only when type=GST; the GSTR period this note was declared in
  gstPeriodDeclared String?  @map("gst_period_declared")
  reason            String?
  createdAt         DateTime @default(now()) @map("created_at")

  shop        Shop         @relation(fields: [shopId], references: [shopId])
  invoice     Invoice      @relation(fields: [linkedInvoiceId], references: [invoiceId])
  party       Party?       @relation(fields: [partyId], references: [partyId])
  salesReturn SalesReturn?

  @@index([shopId, issueDate(sort: Desc)])
  @@index([shopId, type])
  @@index([shopId, status])
  @@map("credit_notes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PURCHASE RETURNS (SUPPLIER RETURNS)
//
// Design: linked to the original PurchaseBill — "opens the original purchase bill"
// per spec. PurchaseBill has no structured line-item table (it stores only a raw
// `extracted` JSON blob), so returnable lines are derived from the Movement rows
// that bill-import/PO-receive already wrote (type PURCHASE/OPENING). Each
// PurchaseReturnItem points at the specific source Movement it's returning against,
// mirroring how SalesReturnItem points at a specific InvoiceItem. There is no
// credit-note engine here — the supplier's own credit note is just a reference
// string; the shop isn't issuing a GST document to itself.
// ═══════════════════════════════════════════════════════════════════════════════

model PurchaseReturn {
  returnId             Int      @id @default(autoincrement()) @map("return_id")
  returnNo             String   @unique @map("return_no") // PR-S{shopId}-{FY}-NNNNN
  shopId               Int      @map("shop_id")
  originalBillId       Int      @map("original_bill_id")
  partyId              Int?     @map("party_id") // supplier, only if registered as a Party
  // Snapshot from the bill — a supplier isn't always a registered Party
  supplierName         String?  @map("supplier_name")
  supplierGstin        String?  @map("supplier_gstin")
  // DAMAGED | WRONG_ITEM | EXCESS_SUPPLY | QUALITY_ISSUE
  reason               String
  // PENDING | SUPPLIER_REFUND | SUPPLIER_CREDIT | REPLACEMENT — evolves as the supplier responds
  resolution           String   @default("PENDING")
  supplierCreditNoteNo String?  @map("supplier_credit_note_no")
  status               String   @default("COMPLETED") // COMPLETED | CANCELLED
  notes                String?
  // Optimistic lock — resolution is updated later via PATCH, days/weeks after creation
  version              Int      @default(0)
  createdBy            Int?     @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")

  shop  Shop                 @relation(fields: [shopId], references: [shopId])
  bill  PurchaseBill         @relation(fields: [originalBillId], references: [billId])
  party Party?               @relation(fields: [partyId], references: [partyId])
  items PurchaseReturnItem[]

  @@index([shopId, createdAt(sort: Desc)])
  @@index([originalBillId])
  @@index([shopId, resolution])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  itemId           Int     @id @default(autoincrement()) @map("item_id")
  returnId         Int     @map("return_id")
  inventoryId      Int     @map("inventory_id")
  // The specific receiving Movement this return is drawn against — enforces
  // "can't return more than was received" per receiving event.
  sourceMovementId Int     @map("source_movement_id")
  qty              Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)
  taxableValue     Decimal @map("taxable_value") @db.Decimal(10, 2)
  gstRate          Decimal @map("gst_rate") @db.Decimal(5, 2)
  cgst             Decimal @db.Decimal(10, 2)
  sgst             Decimal @db.Decimal(10, 2)
  igst             Decimal @default(0) @db.Decimal(10, 2)

  return         PurchaseReturn @relation(fields: [returnId], references: [returnId], onDelete: Cascade)
  inventory      ShopInventory  @relation(fields: [inventoryId], references: [inventoryId])
  sourceMovement Movement       @relation(fields: [sourceMovementId], references: [movementId])

  @@index([returnId])
  @@index([sourceMovementId]) // sum-returned-so-far check per source movement
  @@map("purchase_return_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PURCHASE ORDERS
// ═══════════════════════════════════════════════════════════════════════════════

model PurchaseOrder {
  poId          Int       @id @default(autoincrement()) @map("po_id")
  poNumber      String    @unique @map("po_number")
  shopId        Int       @map("shop_id")
  partyId       Int?      @map("party_id")
  createdBy     Int?      @map("created_by")
  supplierName  String?   @map("supplier_name")
  supplierPhone String?   @map("supplier_phone")
  supplierGstin String?   @map("supplier_gstin")
  subtotal      Decimal   @db.Decimal(10, 2)
  taxableAmount Decimal   @map("taxable_amount") @db.Decimal(10, 2)
  cgst          Decimal   @db.Decimal(10, 2)
  sgst          Decimal   @db.Decimal(10, 2)
  igst          Decimal   @default(0) @db.Decimal(10, 2)
  freight       Decimal   @default(0) @db.Decimal(10, 2)
  otherCharges  Decimal   @default(0) @map("other_charges") @db.Decimal(10, 2)
  totalAmount   Decimal   @map("total_amount") @db.Decimal(10, 2)
  paymentMode   String?   @map("payment_mode")
  status        String    @default("PENDING")
  expectedAt    DateTime? @map("expected_at")
  receivedAt    DateTime? @map("received_at")
  notes         String?
  linkedBillId  Int?      @map("linked_bill_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  shop       Shop                @relation(fields: [shopId], references: [shopId])
  party      Party?              @relation(fields: [partyId], references: [partyId])
  creator    User?               @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [userId])
  items      PurchaseOrderItem[]
  linkedBill PurchaseBill?       @relation(fields: [linkedBillId], references: [billId])

  @@index([shopId, createdAt(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  itemId      Int     @id @default(autoincrement()) @map("item_id")
  poId        Int     @map("po_id")
  inventoryId Int     @map("inventory_id")
  partName    String  @map("part_name")
  hsnCode     String? @map("hsn_code")
  orderedQty  Int     @map("ordered_qty")
  receivedQty Int     @default(0) @map("received_qty")
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  taxableAmt  Decimal @map("taxable_amt") @db.Decimal(10, 2)
  gstRate     Decimal @map("gst_rate") @db.Decimal(5, 2)
  cgst        Decimal @db.Decimal(10, 2)
  sgst        Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [poId], onDelete: Cascade)
  inventory     ShopInventory @relation(fields: [inventoryId], references: [inventoryId])

  @@index([poId])
  @@index([inventoryId])
  @@map("purchase_order_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// WORKSHOP / JOB CARDS
// ═══════════════════════════════════════════════════════════════════════════════

model JobCard {
  jobId         Int       @id @default(autoincrement()) @map("job_id")
  jobNumber     String    @unique @map("job_number")
  shopId        Int       @map("shop_id")
  createdBy     Int?      @map("created_by")
  assignedTo    String?   @map("assigned_to")
  customerName  String    @map("customer_name")
  customerPhone String?   @map("customer_phone")
  vehicleMake   String    @map("vehicle_make")
  vehicleModel  String    @map("vehicle_model")
  vehicleYear   Int?      @map("vehicle_year")
  vehicleReg    String?   @map("vehicle_reg")
  vehicleFuel   String?   @map("vehicle_fuel")
  odometerIn    Int?      @map("odometer_in")
  odometerOut   Int?      @map("odometer_out")
  complaint     String?
  diagnosis     String?
  status        String    @default("RECEIVED")
  priority      String    @default("NORMAL")
  estimatedAt   DateTime? @map("estimated_at")
  completedAt   DateTime? @map("completed_at")
  deliveredAt   DateTime? @map("delivered_at")
  labourCharge  Decimal   @default(0) @map("labour_charge") @db.Decimal(10, 2)
  partsTotal    Decimal   @default(0) @map("parts_total") @db.Decimal(10, 2)
  totalAmount   Decimal   @default(0) @map("total_amount") @db.Decimal(10, 2)
  paymentMode   String?   @map("payment_mode")
  paymentStatus String    @default("PENDING") @map("payment_status")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  shop    Shop          @relation(fields: [shopId], references: [shopId])
  creator User?         @relation("JobCardCreatedBy", fields: [createdBy], references: [userId])
  items   JobCardItem[]

  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, status]) // dashboard open-jobs filter
  @@map("job_cards")
}

model JobCardItem {
  id          Int     @id @default(autoincrement())
  jobId       Int     @map("job_id")
  inventoryId Int?    @map("inventory_id")
  description String
  qty         Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  type        String  @default("PART")

  jobCard   JobCard        @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  inventory ShopInventory? @relation(fields: [inventoryId], references: [inventoryId])

  @@index([jobId])
  @@index([inventoryId])
  @@map("job_card_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MARKETPLACE (B2C)
// ═══════════════════════════════════════════════════════════════════════════════

model MarketplaceOrder {
  orderId             Int       @id @default(autoincrement()) @map("order_id")
  orderNumber         String    @unique @map("order_number")
  customerId          Int?      @map("customer_id")
  customerVehicleId   Int?      @map("customer_vehicle_id")
  shopId              Int       @map("shop_id")
  customerName        String?   @map("customer_name")
  customerPhone       String    @map("customer_phone")
  deliveryAddressId   Int?      @map("delivery_address_id")
  deliveryAddress     String?   @map("delivery_address")
  deliveryFee         Decimal   @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  subtotal            Decimal   @db.Decimal(10, 2)
  total               Decimal   @db.Decimal(10, 2)
  paymentMode         String?   @map("payment_mode")
  razorpayOrderId     String?   @map("razorpay_order_id")
  razorpayPaymentId   String?   @map("razorpay_payment_id")
  // PENDING | PAID | FAILED | REFUNDED
  paymentStatus       String    @default("PENDING") @map("payment_status")
  // Order lifecycle: PENDING | CONFIRMED | PACKED | SHIPPED | DELIVERED | CANCELLED | RETURNED
  status              String    @default("PENDING")
  estimatedDeliveryAt DateTime? @map("estimated_delivery_at")
  deliveredAt         DateTime? @map("delivered_at")
  cancelReason        String?   @map("cancel_reason")
  // Marketplace payout fields
  commissionRate      Decimal   @default(0) @map("commission_rate") @db.Decimal(5, 2)
  payoutAmount        Decimal?  @map("payout_amount") @db.Decimal(10, 2)
  // PENDING | PROCESSING | PAID | HELD
  payoutStatus        String    @default("PENDING") @map("payout_status")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  customer        User?                  @relation("OrderCustomer", fields: [customerId], references: [userId])
  customerVehicle CustomerVehicle?       @relation(fields: [customerVehicleId], references: [id])
  shop            Shop                   @relation(fields: [shopId], references: [shopId])
  deliveryAddr    CustomerAddress?       @relation(fields: [deliveryAddressId], references: [addressId])
  items           MarketplaceOrderItem[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, status]) // shop order management by status
  @@index([paymentStatus]) // payout processing queries
  @@map("marketplace_orders")
}

model MarketplaceOrderItem {
  itemId      Int     @id @default(autoincrement()) @map("item_id")
  orderId     Int     @map("order_id")
  inventoryId Int     @map("inventory_id")
  partName    String  @map("part_name")
  brand       String?
  qty         Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  order     MarketplaceOrder @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  inventory ShopInventory    @relation(fields: [inventoryId], references: [inventoryId])

  @@index([orderId])
  @@index([inventoryId])
  @@map("marketplace_order_items")
}

model MarketplaceReview {
  reviewId         Int      @id @default(autoincrement()) @map("review_id")
  masterPartId     Int      @map("master_part_id")
  inventoryId      Int?     @map("inventory_id")
  orderId          Int?     @map("order_id")
  userId           Int?     @map("user_id")
  customerName     String   @map("customer_name")
  rating           Int
  title            String?
  body             String?
  verifiedPurchase Boolean  @default(false) @map("verified_purchase")
  helpfulCount     Int      @default(0) @map("helpful_count")
  isHidden         Boolean  @default(false) @map("is_hidden")
  createdAt        DateTime @default(now()) @map("created_at")

  masterPart MasterPart     @relation(fields: [masterPartId], references: [masterPartId])
  inventory  ShopInventory? @relation(fields: [inventoryId], references: [inventoryId])
  user       User?          @relation(fields: [userId], references: [userId])

  @@index([masterPartId])
  @@index([inventoryId])
  @@index([userId])
  @@map("marketplace_reviews")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════════════════════════════════════════════

// Immutable server-side audit trail — INSERT ONLY, never UPDATE or DELETE.
// Records who did what, from where, and what changed for every mutating action.
model AuditLog {
  auditId    Int      @id @default(autoincrement()) @map("audit_id")
  userId     Int?     @map("user_id")
  shopId     Int?     @map("shop_id")
  // PRODUCT | INVOICE | PARTY | ORDER | AUTH | BILL | STOCK | PROFILE | SHOP | ADMIN
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  // CREATE | UPDATE | DELETE | EXPORT | LOGIN | LOGOUT | IMPORT | ADJUST | SALE | PURCHASE | APPROVE | REJECT
  action     String
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  // { userAgent, referer, origin }
  deviceInfo Json     @default("{}") @map("device_info")
  sessionId  String?  @map("session_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([shopId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([shopId, entityType])
  @@map("audit_logs")
}

model NumberCounter {
  shopId     Int      @map("shop_id")
  counterKey String   @map("counter_key")
  lastValue  Int      @default(0) @map("last_value")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [shopId], onDelete: Cascade)

  @@id([shopId, counterKey])
  @@map("number_counters")
}

model FeatureFlag {
  id             Int      @id @default(autoincrement())
  key            String   @unique
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  enabledForAll  Boolean  @default(false) @map("enabled_for_all")
  enabledShopIds Int[]    @default([]) @map("enabled_shop_ids")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}
