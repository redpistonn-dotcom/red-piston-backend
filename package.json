{
  "name": "autospace-backend",
  "version": "1.0.0",
  "description": "AutoSpace ERP + Marketplace Backend",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "scrape:autodukan": "node scripts/scrape-autodukan.mjs",
    "scrape:autodukan:resume": "node scripts/scrape-autodukan.mjs --resume"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "opossum": "^9.0.0",
    "pdf-parse": "^1.1.1",
    "pdfmake": "^0.2.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.9.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "nodemon": "^3.1.0",
    "pg": "^8.21.0",
    "playwright": "^1.61.0",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  }
}
